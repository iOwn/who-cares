# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
# Vitest browser-mode artifacts: failure screenshots (browser.screenshotFailures
# defaults on in headless mode) and trace-view output.
/.vitest
# Playwright E2E: the HTML report, and the per-parent storageState that
# `e2e/global-setup.ts` mints against the test seam (short-lived session tokens).
/playwright-report
/test-results
/e2e/.auth

# next.js
/.next/
/out/

# production — also Ladle's default outDir (`pnpm workbench:build`)
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
pnpm-debug.log*

# env files — .env.ci is committed on purpose (see docs/testing.md); ignore only
# local overrides and the throwaway .env the `build` job / a local sanity-check
# copies from .env.ci (`cp .env.ci .env`).
.env*.local
/.env
/.env.production
/.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
