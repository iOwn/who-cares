# .env.ci — committed on purpose. Every value here is fake.
#
# This file exists so `next build` has a complete environment in CI (and as a
# local `next build` sanity-check: `cp .env.ci .env && pnpm build`). It is safe
# to commit because:
#   - nothing in it is a real credential — the DB host is localhost, the secrets
#     are throwaway strings, the VAPID pair was generated once for this file and
#     is used nowhere;
#   - authed routes are dynamic, so `next build` never opens a DB connection or
#     validates a session — it only needs the vars to be *present*.
# See docs/testing.md "CI pipeline shape".
#
# Next 16 does not load `.env.ci` automatically (only `.env` / `.env.production`),
# so the `build` job copies this to `.env` first.

# --- Database (ADR-0006: Neon in prod, PGlite in tests; neither is reachable in CI) ---
DATABASE_URL=postgres://ci:ci@localhost:5432/ci

# --- Auth (Better Auth) — dummy secret, dummy base URL ---
BETTER_AUTH_SECRET=ci0000000000000000000000000000000000000000000
BETTER_AUTH_URL=http://localhost:3000

# --- Web Push / VAPID (ADR-0004) — throwaway keypair, not registered anywhere ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BP0-ui28D8rKb1CfmxQ-lDsU5wZQU8rcwciBDaJFzx60Dc2t9UBIwsYx-a_gbI0lOjOJeGPeDyWK_I3hnw-hYzo
VAPID_PRIVATE_KEY=T_-jjN9zH9xp3Hel1uDkDfZMhkWaoyJx_XbkHU36hrs
VAPID_SUBJECT=mailto:ci@whocares.invalid

# --- E2E test seam — never set here; the preview deploy sets it (ADR-0008) ---
# E2E_TEST_MODE=
